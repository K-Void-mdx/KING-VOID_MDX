# NOVA_VOID MDX configuration
NODE_ENV=production
BOT_NAME=NOVA_VOID MDX
PREFIX=.

# Owner JID(s), comma-separated for multiple. Example: 2348012345678@s.whatsapp.net
OWNER_JIDS=
# Trusted/sudo users (lower than owner): comma-separated
SUDO_JIDS=

# Phone number used ONLY for first-time pairing (country code + number, no + or spaces)
PAIR_PHONE=

# WhatsApp auth directory. Never commit its contents.
AUTH_DIR=./data/auth

# Local data directory (chatbot state, history, training memory)
DATA_DIR=./data

# Max messages kept per conversation session
AI_MAX_HISTORY=40

# ---- AI providers ----
# Add keys later. Never commit real keys. No provider is active until set AND
# a matching adapter is registered in src/ai/router.js.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
